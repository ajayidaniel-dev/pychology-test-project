generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                      String              @id @default(cuid())
  name                    String?
  email                   String?             @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  verificationToken       String?             @unique
  verificationTokenExpiry DateTime?
  accounts                Account[]
  clinicalSessions        ClinicalSession[]
  patients                Patient[]
  scales                  Scale[]
  sessions                Session[]
  notes                   Note[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
}

model Scale {
  id             String              @id @default(cuid())
  name           String
  description    String?
  psychologistId String?
  isLibrary      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  questionnaires Questionnaire[]
  psychologist   User?               @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  items          ScaleItem[]
  thresholds     SeverityThreshold[]
}

model ScaleItem {
  id       String           @id @default(cuid())
  scaleId  String
  order    Int
  text     String
  type     ItemType
  required Boolean          @default(true)
  options  ResponseOption[]
  scale    Scale            @relation(fields: [scaleId], references: [id], onDelete: Cascade)
}

model ResponseOption {
  id     String    @id @default(cuid())
  itemId String
  label  String
  value  Int?
  order  Int
  item   ScaleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model SeverityThreshold {
  id       String @id @default(cuid())
  scaleId  String
  label    String
  minScore Int
  maxScore Int
  scale    Scale  @relation(fields: [scaleId], references: [id], onDelete: Cascade)
}

model Patient {
  id                 String              @id @default(cuid())
  displayName        String
  anonymousId        String
  psychologistId     String
  fullName           String?
  email              String?
  phone              String?
  dateOfBirth        DateTime?
  detailsUpdatedAt   DateTime?
  // Cross-session clinical summary. summarySessionCount records how many
  // completed sessions it was built from, so the UI can tell the clinician the
  // summary predates newer assessments instead of showing it as current.
  summary             Json?
  summaryGeneratedAt  DateTime?
  summarySessionCount Int?
  createdAt          DateTime            @default(now())
  clinicalSessions   ClinicalSession[]
  notes              Note[]
  notifications      Notification[]
  psychologist       User                @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([anonymousId, psychologistId])
}

/// A clinical session is an appointment: a patient, a date, and a reason.
/// Questionnaires hang off it — a session is not itself a questionnaire.
/// The fill link is session-level, so one link walks the patient through every
/// questionnaire attached to that session.
model ClinicalSession {
  id             String                @id @default(cuid())
  patientId      String
  psychologistId String
  title          String
  reason         String?
  scheduledAt    DateTime
  status         ClinicalSessionStatus @default(SCHEDULED)

  token                String    @unique
  tokenExpiresAt       DateTime
  collectDetails       Boolean   @default(false)
  consentAt            DateTime?
  consentPolicyVersion String?

  createdAt      DateTime        @default(now())
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  psychologist   User            @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  questionnaires Questionnaire[]
  notes          Note[]
  notifications  Notification[]

  @@index([patientId, scheduledAt])
}

model Questionnaire {
  id        String              @id @default(cuid())
  sessionId String
  scaleId   String
  order     Int                 @default(1)
  status    QuestionnaireStatus @default(PENDING)
  createdAt DateTime            @default(now())

  session  ClinicalSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scale    Scale                  @relation(fields: [scaleId], references: [id])
  response      QuestionnaireResponse?
  notes         Note[]
  notifications Notification[]

  @@index([sessionId, order])
}

model QuestionnaireResponse {
  id              String        @id @default(cuid())
  questionnaireId String        @unique
  itemScores      Json
  intakeAnswers   Json?
  totalScore      Int
  severity        String
  completedAt     DateTime      @default(now())
  reviewedAt      DateTime?
  escalatedAt     DateTime?
  narrative            Json?
  narrativeGeneratedAt DateTime?
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
}

/// One note table for all three levels. patientId is always set so the patient
/// page can render a single chronological stream; sessionId/questionnaireId
/// narrow what the note is attached to.
model Note {
  id              String   @id @default(cuid())
  authorId        String
  patientId       String
  sessionId       String?
  questionnaireId String?
  body            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  patient       Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  session       ClinicalSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire?   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([sessionId])
  @@index([questionnaireId])
}

enum ItemType {
  MULTIPLE_CHOICE
  YES_NO
  FREE_TEXT
  NUMBER
}

enum QuestionnaireStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum ClinicalSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  QUESTIONNAIRE_COMPLETED
  SEVERITY_CRITICAL
  SEVERITY_HIGH
  SUICIDAL_IDEATION
  UNREVIEWED_SEVERE
  LINK_EXPIRING_SOON
  LINK_EXPIRED
  LOGIN
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  patientId String?
  // sessionId is the ClinicalSession; questionnaireId narrows to one
  // questionnaire within it. Link-expiry alerts are session-level (the token
  // lives there), completion/severity alerts are questionnaire-level.
  sessionId       String?
  questionnaireId String?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // Cascades keep the bell honest: a notification must never outlive the thing
  // it links to, or clicking it lands on a 404.
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient       Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  session       ClinicalSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire?   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  userId  String
  type    NotificationType
  enabled Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}
